RELION 5.1.1 post-tag fixes from github.com/3dem/relion, 5.1.1 to afdd8167, without README.md.
Code commits included:
  7aa7d206 set version to 5.1.1
  05cd1ad9 repaired nasty bug in writing ispg=1 for single 2D mrc files
  afdd418b use consistent tomogram centre in setProjectionMatrix
  2bba98f0 fix visiblity determination for subtomo particle reconstruction
  5a450ba2 Clear deferred-free state when the custom GPU allocator frees a block (#1375)
  afdd8167 ensures correct allocation sizes via integer math (#1377)

diff --git a/src/acc/cuda/custom_allocator.cuh b/src/acc/cuda/custom_allocator.cuh
index eb890d3209917c92441f5a034c6d1c310f3c6554..5c0bf8ecb0fe04dd726e4e61e8ee0fb55f2063d1 100644
--- a/src/acc/cuda/custom_allocator.cuh
+++ b/src/acc/cuda/custom_allocator.cuh
@@ -364,6 +364,15 @@ private:
 
 		a->free = true;
 
+		// Clear any deferred-free state: alloc() may hand this record out again as an exact fit,
+		// and a stale freeWhenReady/readyEvent would make _freeReadyAllocs() free it under its new owner.
+		if (a->readyEvent != 0)
+		{
+			DEBUG_HANDLE_ERROR(cudaEventDestroy(a->readyEvent));
+			a->readyEvent = 0;
+		}
+		a->freeWhenReady = false;
+
 		if (cache)
 		{
 			//Previous neighbor is free, concatenate
@@ -500,7 +509,7 @@ public:
 
 		if (cache)
 		{
-			size = alignmentSize*ceilf( (float)size / (float)alignmentSize) ; //To prevent miss-aligned memory
+			size = ((size + alignmentSize - 1) / alignmentSize) * alignmentSize; //To prevent miss-aligned memory (integer arithmetic: float rounding returned undersized allocations above 16 MB)
 
 			Alloc *curAlloc = _getFirstSuitedFree(size);
 
